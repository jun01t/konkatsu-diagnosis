# --- Vercel 単体デプロイ（推奨）---
# NEXT_PUBLIC_API_URL 未設定 → ブラウザは同一オリジンの /api/*（Route Handlers）

# Vercel AI Gateway（未設定かつ VERCEL_OIDC_TOKEN も無い場合はモック診断）
# ダッシュボード: https://vercel.com/d?to=%2F%5Bteam%5D%2F%7E%2Fai%2Fapi-keys
# AI_GATEWAY_API_KEY=
# AI_GATEWAY_MODEL=openai/gpt-4o-mini

# --- Go API を別ホストで動かす場合 ---
# NEXT_PUBLIC_API_URL=http://localhost:8080

# OGP・canonical 用（Vercel では未設定でも VERCEL_URL で補完）
NEXT_PUBLIC_SITE_URL=http://localhost:3000
